# ResourceBridge Environment Configuration Template
# Copy this file to .env for local overrides

# Application Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=dev-hackathon-insecure-secret-key-change-in-prod

# Database URI (defaults to SQLite in the instance/ directory)
# DATABASE_URL=sqlite:///instance/resourcebridge.db

# Flask Environment Mode
FLASK_ENV=development
FLASK_DEBUG=1
